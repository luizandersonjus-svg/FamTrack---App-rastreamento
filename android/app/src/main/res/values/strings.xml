    <!-- Onboarding de permissões -->
    <string name="onboarding_welcome_title">Bem-vindo ao FamTrack</string>
    <string name="onboarding_welcome_text">Em alguns passos você vai liberar o que o FamTrack precisa para funcionar bem: localização, notificações e otimização de bateria. Você pode pular qualquer etapa.</string>
    <string name="onboarding_btn_start">Começar</string>
    <string name="onboarding_btn_continue">Continuar</string>
    <string name="onboarding_btn_finish">Concluir</string>
    <string name="onboarding_btn_skip">Pular por enquanto</string>
    <string name="onboarding_btn_open_settings">Abrir configurações</string>
    <string name="onboarding_btn_battery_settings">Abrir otimização de bateria</string>
    <string name="onboarding_open_settings_toast">Você será levado às configurações do sistema</string>
    <string name="onboarding_location_title">Localização</string>
    <string name="onboarding_location_text">Sua posição é compartilhada apenas com sua família. Com a localização liberada, eles veem no mapa onde você está.</string>
    <string name="onboarding_location_denied">Sem a localização, você não aparece no mapa da família. Toque em "Abrir configurações" para liberar quando quiser.</string>
    <string name="onboarding_background_title">Localização em segundo plano</string>
    <string name="onboarding_background_text_q">Permita também a localização em segundo plano, para que sua família veja sua posição mesmo com o app fechado.</string>
    <string name="onboarding_background_text_r">No Android 11+, isso é feito nas configurações do sistema. Você será levado à tela de permissões do FamTrack.</string>
    <string name="onboarding_background_needed">Sem a permissão em segundo plano, sua posição só é vista com o FamTrack aberto.</string>
    <string name="onboarding_background_settings_hint">Depois de liberar em segundo plano, toque em Continuar abaixo.</string>
    <string name="onboarding_notifications_title">Notificações</string>
    <string name="onboarding_notifications_text">Alertas de SOS, chegadas, saídas e check-ins são enviados por aqui. Sem elas, você ainda pode ver tudo dentro do app.</string>
    <string name="onboarding_notifications_denied">Sem as notificações, você não recebe alertas fora do app.</string>
    <string name="onboarding_battery_title">Otimização de bateria</string>
    <string name="onboarding_battery_text">Seu aparelho pode pausar o FamTrack para economizar bateria, e aí a localização para de ser enviada. Vamos desativar isso para o app.</string>
    <string name="onboarding_battery_brand">Instruções para %1$s:</string>
    <string name="onboarding_battery_samsung">Em Samsung: 1) Configurações > Aplicativos > FamTrack > Bateria > "Sem restrições". 2) Configurações > Bateria > Limites de uso em segundo plano > "Apps nunca suspensos" > adicionar o FamTrack. 3) Configurações > Localização > Permissões de app > FamTrack > "Permitir o tempo todo".</string>
    <string name="onboarding_battery_xiaomi">Abra Configurações > Bateria > Economia de energia > Restrições de apps em segundo plano: desative restrições de Bateria e Não poupar para o FamTrack.</string>
    <string name="onboarding_battery_huawei">Abra Gerenciador de aplicativos > Bateria > Início do aplicativo: deixe o FamTrack em "Gerenciar manualmente" com todas as opções ligadas (Auto-start, Atividade secundária e Executar em segundo plano).</string>
    <string name="onboarding_battery_motorola">Abra Configurações > Bateria > Otimização de bateria e escolha "Não otimizar" para o FamTrack.</string>
    <string name="onboarding_battery_oppo">Abra Configurações > Bateria > Gerenciamento de bateria: escolha "Permitir em segundo plano" para o FamTrack.</string>
    <string name="onboarding_battery_generic">Abra as configurações de bateria do aparelho e procure a opção de não otimizar o FamTrack (ou de manter o app ativo em segundo plano).</string>
    <string name="onboarding_done_title">Tudo pronto!</string>
    <string name="onboarding_done_text">Sua família já pode começar a acompanhar você. Se precisar, tudo isso pode ser revisto nas configurações.</string>

