<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissões de Localização -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Reconhecimento de atividade (passos / meio de transporte) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Servi\u00e7o em foreground (para localiza\u00e7\u00e3o em background) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Reiniciar o rastreamento ap\u00f3s reiniciar o aparelho -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Notificações -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Internet (para Supabase) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Health Connect (batimentos do relogio/banda) -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:name=".FamTrackApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FamTrack"
        tools:targetApi="34">

        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${GOOGLE_MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FamTrack"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.famtrack.app"
                    android:host="login-callback" />
            </intent-filter>
        </activity>

        <!--
            Health Connect: politica de privacidade dos dados de saude.
            Sem estas duas entradas o Health Connect recusa o pedido de
            permissao na hora (o contrato devolve um conjunto vazio).
            - Android 13 ou anterior: ACTION_SHOW_PERMISSIONS_RATIONALE.
            - Android 14+: activity-alias com VIEW_PERMISSION_USAGE +
              HEALTH_PERMISSIONS (protegido por START_VIEW_PERMISSION_USAGE,
              que so o sistema possui).
        -->
        <activity
            android:name=".feature.healthsnap.HealthPrivacyPolicyActivity"
            android:exported="true"
            android:label="@string/health_privacy_title"
            android:theme="@style/Theme.FamTrack">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".feature.healthsnap.HealthPrivacyPolicyActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Serviço de Localização -->
        <service
            android:name=".service.LocationService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- Reinicia o rastreamento após o boot ou após atualização/instalação do app -->
        <receiver
            android:name=".service.ServiceAutoStartReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
